{#
	Argon is a clean HTML5 theme for LuCI. Based on luci-theme-bootstrap, MUI and Argon Template.
	
	Redesigned with shadcn-inspired dark aesthetic:
	- Centered card on full-screen background
	- Subtle glass effect with dark overlay
	- Clean input focus states with animated underline
	- Muted secondary text, primary accent CTAs

	luci-theme-argon
	Copyright 2020 Jerryk <jerrykuku@gmail.com>
	Licensed to the public under the Apache License 2.0
-#}

{% include("themes/" + theme + "/out_header_login") %}
{%
	import * as fs from 'fs';
	import { cursor } from 'uci';
	import { rand } from 'math';

	let cfg = cursor();

	const imageTypes = " jpg jpeg png gif webp ";
	const videoTypes = " mp4 webm ";
	const allTypes = imageTypes + videoTypes;

	function fetchMedia(path, themeDir) {
		let backgroundTable = [];
		for (f in (fs.lsdir(path))) {
			let ext = lc(split(f, '.')?.[1]);
			if (ext && index(allTypes, " " + ext + " ") != -1) {
				let bg = {};
				bg.type = ext;
				bg.url = themeDir + f;
				push(backgroundTable, bg);
			}
		}
		return backgroundTable;
	}

	function selectBackground(themeDir) {
		let bgUrl = media + "/img/bg1.jpg";
		let backgroundType = "Image";
		let mimeType = "";

		if (fs.access("/etc/config/argon")) {
			let online_wallpaper = cfg.get_first('argon', 'global', 'online_wallpaper') ?? (cfg.get_first('argon', 'global', 'bing_background') == '1' ? 'bing' : null);
			if (online_wallpaper && online_wallpaper != "none") {
				const picurl = ubus.call("luci.argon_wallpaper", "get_url") ?? {};
				if (picurl?.url) {
					bgUrl = picurl.url;
					return {bgUrl, backgroundType, mimeType};
				}
			}
		}

		let background = fetchMedia("/www" + themeDir, themeDir);
		if ( length(background) > 0 ) {
			let currentBg = background[(rand() % length(background))];
			bgUrl = currentBg.url;
			if (index(videoTypes, " " + currentBg.type + " ") != -1) {
				backgroundType = "Video";
				mimeType = "video/" + currentBg.type;
			}
		}

		return {bgUrl, backgroundType, mimeType};
	}

	const boardinfo = ubus.call("system", "board");
	const hostname = striptags(boardinfo?.hostname ?? '?');
	const themeDir = media + "/background/";
	const bgArry = selectBackground(themeDir);

%}
<div class="login-page">
	{% if ( bgArry.backgroundType == "Video" ): %}
	<div class="login-bg-video">
		<video autoplay loop muted id="video">
			<source src="{{ bgArry.bgUrl }}" type="{{ bgArry.mimeType }}">
		</video>
	</div>
	<button class="volume-control mute" aria-label="Toggle sound"></button>
	<script>
		document.querySelector(".volume-control").addEventListener("click", function(){
			this.classList.toggle("mute");
			document.getElementById("video").muted = !this.classList.contains("mute");
		});
	</script>
	{% else %}
	<div class="login-bg-image" style="background-image:url({{ bgArry.bgUrl }})"></div>
	{% endif %}

	<!-- Scrim overlay for readability -->
	<div class="login-overlay"></div>

	<!-- Login card (shadcn-inspired) -->
	<div class="login-card">
		<div class="login-card-body">
			<!-- Brand -->
			<a class="login-brand" href="/">
				<img src="{{ media }}/img/argon.svg" alt="" class="login-brand-icon">
				<span class="login-brand-text">{{ hostname }}</span>
			</a>

			<!-- Error -->
			{%- if (fuser): %}
			<div class="login-error">{{ _('Invalid username and/or password! Please try again.') }}</div>
			{% endif -%}

			<!-- Form -->
			<form class="login-form" method="post" action="{{ http.getenv("REQUEST_URI") }}">
				<div class="login-field">
					<label class="login-label" for="cbi-input-user">{{ _('Username') }}</label>
					<input class="login-input" id="cbi-input-user" type="text" name="luci_username" value="{{ entityencode(duser, true) }}" placeholder="{{ _('Enter username') }}" autocomplete="username">
					<div class="login-input-bar"></div>
				</div>
				<div class="login-field">
					<label class="login-label" for="cbi-input-password">{{ _('Password') }}</label>
					<input class="login-input" id="cbi-input-password" type="password" name="luci_password" placeholder="{{ _('Enter password') }}" autocomplete="current-password">
					<div class="login-input-bar"></div>
				</div>
				<button type="submit" class="login-button">{{ _('Log in') }}</button>
			</form>
		</div>

		<div class="login-card-footer">
			<a href="https://github.com/openwrt/luci" target="_blank" rel="noopener">Powered by {{ version.luciname }}</a>
			<span class="login-footer-dot">·</span>
			<a href="https://github.com/jerrykuku/luci-theme-argon" target="_blank" rel="noopener">Argon</a>
			<span class="login-footer-dot">·</span>
			<a href="{{ version.disturl }}" target="_blank" rel="noopener">{{ version.distname }} {{ version.distversion }}</a>
		</div>
	</div>
</div>

<script type="text/javascript">//<![CDATA[
	var input = document.getElementsByName('luci_password')[0];
	if (input) input.focus();
//]]></script>

{% include("themes/" + theme + "/footer_login") %}
